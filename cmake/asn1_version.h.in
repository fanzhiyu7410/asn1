/*
 * 核心版本头模板。由 CMake configure_file 从 project(asn1 VERSION ...) 生成，
 * 源码树中不手写版本宏。生成结果安装为 include/asn1/asn1_version.h。
 */
#ifndef ASN1_VERSION_H_INCLUDED
#define ASN1_VERSION_H_INCLUDED

#include <stddef.h>
#include <stdint.h>

#include <asn1/asn1_error.h>
#include <asn1/asn1_export.h>

#define ASN1_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ASN1_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ASN1_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ASN1_VERSION_STRING "@PROJECT_VERSION@"

/* 编码规则：major << 16 | minor << 8 | patch */
#define ASN1_VERSION_ENCODED \
    ((ASN1_VERSION_MAJOR << 16) | (ASN1_VERSION_MINOR << 8) | ASN1_VERSION_PATCH)

/* 能力位，取值与语义见 docs/02-C-API规范.md 6.5。 */
#define ASN1_CAP_SCHEMA_TABLE_LOAD (UINT64_C(1) << 0)
#define ASN1_CAP_SCHEMA_RUNTIME_REGISTER (UINT64_C(1) << 1)
#define ASN1_CAP_STRICT_SCHEMA (UINT64_C(1) << 2)
#define ASN1_CAP_WARNING (UINT64_C(1) << 3)
#define ASN1_CAP_BER_CONSTRUCTED_STRING (UINT64_C(1) << 4)
#define ASN1_CAP_TIME_NANOSECOND (UINT64_C(1) << 5)
#define ASN1_CAP_BIGINT_DECIMAL (UINT64_C(1) << 6)
#define ASN1_CAP_ENCODE_SCHEMA_AWARE (UINT64_C(1) << 7)
#define ASN1_CAP_CER (UINT64_C(1) << 8)
#define ASN1_CAP_PER (UINT64_C(1) << 9)
#define ASN1_CAP_ANY_OPEN_TYPE (UINT64_C(1) << 10)
#define ASN1_CAP_SCHEMA_NAMES (UINT64_C(1) << 11)

typedef struct asn1_version_info {
    size_t struct_size;                 /* 输入：必须为 sizeof(asn1_version_info_t) */
    uint32_t major;                     /* 实际链接库的主版本 */
    uint32_t minor;
    uint32_t patch;
    uint32_t reserved;                  /* 必须置零 */
    const char *string;                 /* 静态存储，随库生命周期有效，永不释放 */
    uint64_t capabilities;              /* ASN1_CAP_* 位集合，见 6.5 */
} asn1_version_info_t;

#ifdef __cplusplus
extern "C" {
#endif

ASN1_API asn1_err_t asn1_version(asn1_version_info_t *out_info);
ASN1_API asn1_err_t asn1_version_check(uint32_t expected_major,
                                       uint32_t expected_minor);
ASN1_API int        asn1_has_capability(uint64_t capability);

#ifdef __cplusplus
}
#endif

#endif /* ASN1_VERSION_H_INCLUDED */
