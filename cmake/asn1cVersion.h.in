/*
 * asn1c 独立版本头模板。由 tools/asn1c 自己的 project(... VERSION ...) 生成，
 * 源码树中不手写版本字符串。该头只供工具内部使用，不随工具安装。
 */
#ifndef ASN1C_VERSION_H_INCLUDED
#define ASN1C_VERSION_H_INCLUDED

#define ASN1C_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ASN1C_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ASN1C_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ASN1C_VERSION_STRING "@PROJECT_VERSION@"

/* 编码规则：major << 16 | minor << 8 | patch */
#define ASN1C_VERSION_ENCODED \
    ((ASN1C_VERSION_MAJOR << 16) | (ASN1C_VERSION_MINOR << 8) | ASN1C_VERSION_PATCH)

#endif /* ASN1C_VERSION_H_INCLUDED */
