/*
 * 模块版本头模板。由 CMake configure_file 从模块自己的 project(... VERSION ...)
 * 生成，源码树中不手写版本宏。
 * 生成结果安装为 include/asn1/<module>/<module>_version.h。
 */
#ifndef @ASN1_MODULE_MACRO@_VERSION_H_INCLUDED
#define @ASN1_MODULE_MACRO@_VERSION_H_INCLUDED

#define @ASN1_MODULE_MACRO@_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define @ASN1_MODULE_MACRO@_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define @ASN1_MODULE_MACRO@_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define @ASN1_MODULE_MACRO@_VERSION_STRING "@PROJECT_VERSION@"

/* 编码规则：major << 16 | minor << 8 | patch */
#define @ASN1_MODULE_MACRO@_VERSION_ENCODED \
    ((@ASN1_MODULE_MACRO@_VERSION_MAJOR << 16) | \
     (@ASN1_MODULE_MACRO@_VERSION_MINOR << 8) | \
     @ASN1_MODULE_MACRO@_VERSION_PATCH)

#endif /* @ASN1_MODULE_MACRO@_VERSION_H_INCLUDED */
